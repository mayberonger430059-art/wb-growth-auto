  "description": "WorkBuddy 成长计划自动完成器：环境自检、任务查询/接取/领奖、签到、猫猫旅行、抽奖（wbipc 桥），以及 CDP 驱动的体验类任务 UI 自动化（专家/专家团/模板/定时任务）",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "wb-call": "scripts/wb-call.cjs",
    "wb-growth": "scripts/wb-growth.cjs",
    "wb-harvest": "scripts/wb-harvest.cjs",
    "wb-tasks": "scripts/wb-tasks.cjs",
    "wb-doctor": "scripts/wb-doctor.cjs"
  },
  "scripts": {
    "status": "node scripts/wb-growth.cjs status",
    "harvest": "node scripts/wb-harvest.cjs",
    "report": "node scripts/wb-harvest.cjs --report",
    "doctor": "node scripts/wb-doctor.cjs",
    "accept": "node scripts/wb-growth.cjs accept-all",
    "claim": "node scripts/wb-growth.cjs claim-all"
  },
  "keywords": [
    "workbuddy",
    "growth-plan",
    "automation",
    "cdp",
    "skill"
  ]
}
